resource "aws_security_group" "worker" {
  name        = "${var.project_name}-worker-sg"
  description = "Worker task security group"
  vpc_id      = var.vpc_id

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "${var.project_name}-worker-sg"
